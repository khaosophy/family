---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Daniel's First Birthday">
	<div class="hero">
		<div class="animals-top">🦒 🐘 🦁 🐆 🦓 🐻 🦏 🐊</div>
		<h1>
			Daniel's First Birthday
			<div class="age-badge">1</div>
		</h1>
		<div class="animals-bottom">🦜 🐍 🦚 🦩 🐢 🦋 🦅 🦡</div>
	</div>

	<main>
		<p class="intro">They grow up so fast! It seems like just last week that Daniel was born. Now he's turning one! We're so excited to celebrate with you. Please join us for a fun-filled day of food, friends, family, and animals!</p>

		<div class="card-grid">
			<div class="card">
				<h2><span class="icon">🗓️</span> When?</h2>
				<p>
					<strong>Date:</strong> Saturday, May 30, 2026<br/>
					<strong>Time:</strong> 10:30am – 1:30pm
				</p>
				<div class="cal-dropdown">
					<button class="btn btn-outline cal-btn">Add to Calendar <span class="chevron">▾</span></button>
					<ul class="cal-menu">
						<li><a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Daniel%27s+First+Birthday&dates=20260530T143000Z%2F20260530T173000Z&location=Turtle+Back+Zoo%2C+560+Northfield+Ave%2C+West+Orange%2C+NJ+07052&details=Join+us+to+celebrate+Daniel%27s+first+birthday+at+Turtle+Back+Zoo!" target="_blank">Google Calendar</a></li>
						<li><a href="https://outlook.live.com/calendar/0/action/compose?subject=Daniel%27s+First+Birthday&startdt=2026-05-30T14%3A30%3A00Z&enddt=2026-05-30T17%3A30%3A00Z&location=Turtle+Back+Zoo%2C+560+Northfield+Ave%2C+West+Orange%2C+NJ+07052&body=Join+us+to+celebrate+Daniel%27s+first+birthday+at+Turtle+Back+Zoo!" target="_blank">Outlook</a></li>
						<li><a href="/daniel-birthday-1.ics" download>Apple / Other (.ics)</a></li>
					</ul>
				</div>
			</div>

			<div class="card">
				<h2><span class="icon">📍</span> Where?</h2>
				<address>
					Turtle Back Zoo<br/>
					560 Northfield Ave<br/>
					West Orange, NJ 07052
				</address>
				<div class="btn-row">
					<a class="btn" href="https://www.turtlebackzoo.com/" target="_blank">Zoo Website</a>
					<a class="btn btn-outline" href="https://www.google.com/maps/place/Essex+County+Turtle+Back+Zoo/@40.7676893,-74.2824864,17z/data=!3m1!4b1!4m6!3m5!1s0x89c3ab9108f88317:0x7d4c14c9be019b5c!8m2!3d40.7676853!4d-74.2799115!16zL20vMGZiOTMy?hl=en-US&entry=ttu&g_ep=EgoyMDI2MDQxMi4wIKXMDSoASAFQAw%3D%3D" target="_blank">Get Directions</a>
				</div>
			</div>
		</div>

		<div class="card">
			<h2><span class="icon">🚗</span> Arrival & Check-in</h2>
			<ul>
				<li><strong>Parking is free.</strong> Once you arrive, you will be directed to one of the free parking areas.</li>
				<li><strong>Check in at Window #2</strong> at the Main Entrance — that's where our guest list will be. Tell them you're here for Daniel's First Birthday.</li>
				<li><strong>Finding us:</strong> Once inside, turn left and head towards Bear Country. Our private area is in the gazebo located between Bear Country and the carousel.</li>
			</ul>
			<p class="rsvp-note">Note: if you did not RSVP, your name may not be on the guest list and you could be asked to pay the general admission fee.</p>
		</div>

		<div class="card map-card">
			<h2><span class="icon">🗺️</span> Map</h2>
			<p>Directions to our private gazebo are marked below — between Bear Country and the carousel.</p>
			<div class="map-container" id="map-container">
				<img src="/turtleback-map-directions.png" alt="Turtle Back Zoo map" class="zoo-map" />
				<button class="map-expand-btn" id="map-expand-btn" aria-label="View full size map">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/>
						<line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/>
					</svg>
					Expand
				</button>
			</div>
		</div>

		<dialog id="map-dialog" class="map-dialog">
			<button class="dialog-close" id="dialog-close" aria-label="Close">✕</button>
			<img src="/turtleback-map-directions.png" alt="Turtle Back Zoo map" />
		</dialog>

		<div class="card">
			<h2><span class="icon">📋</span> Agenda</h2>
			<ul class="agenda">
				<li><span class="time">10:30am</span> Greetings!</li>
				<li><span class="time">11:30am</span> Lunch</li>	
				<li><span class="time">12:00pm</span> Happy Birthday &amp; Desserts</li>
				<li><span class="time">12:30pm</span> Stroll the Zoo!</li>
			</ul>
		</div>

		<div class="card">
			<h2><span class="icon">🍕</span> Food</h2>
			<p>We will have pizza for everyone:</p>
			<ul>
				<li>1 plain, cut into 16 slices for the kids</li>
				<li>2 plain</li>
				<li>2 sausage &amp; onion</li>
			</ul>
		</div>

		<div class="card">
			<h2><span class="icon">🎁</span> What can we bring?</h2>
			<p>Please refrain from buying or giving presents.</p>
			<p>However, if you're inclined, please consider contributing to <a href="https://www.ugift529.com/gifttpl/ugift/create/viewGiftCodeDetails.cs?ugiftcode=W2T-K8S" target="_blank">Daniel's college fund</a>, or consider donating to <a href="/donate">one of these charities</a> in his name.</p>
		</div>

		<div class="card">
			<h2><span class="icon">ℹ️</span> Good to Know</h2>
			<ul>
				<li>The venue is outside, under a gazebo — dress appropriately.</li>
				<li>Wear comfortable walking shoes, especially if you plan to explore the zoo.</li>
				<li>Alcohol is not allowed on site.</li>
			</ul>
		</div>

		<div class="footer-animals">🦒 🐘 🦁 🐆 🦓 🐻</div>
	</main>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700&display=swap');

	:root {
		--green-dark: #1a4731;
		--green-mid: #2d6a4f;
		--green-light: #52b788;
		--yellow: #f4c430;
		--yellow-light: #fff3b0;
		--cream: #fefae0;
		--brown: #7b4f3a;
		--text: #2d2d2d;
		--card-bg: #ffffff;
		--card-border: #d4e6d4;
	}

	/* ── Hero ── */
	.hero {
		background: linear-gradient(160deg, var(--green-dark) 0%, var(--green-mid) 60%, #40916c 100%);
		color: white;
		text-align: center;
		padding: 3rem 1.5rem 2.5rem;
		position: relative;
		overflow: hidden;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image: radial-gradient(circle at 20% 80%, rgba(255,255,255,0.04) 0%, transparent 50%),
		                  radial-gradient(circle at 80% 20%, rgba(244,196,48,0.08) 0%, transparent 50%);
	}

	.animals-top,
	.animals-bottom {
		font-size: 1.6rem;
		letter-spacing: 0.3rem;
		opacity: 0.85;
		position: relative;
	}

	.animals-bottom {
		margin-top: 1.5rem;
	}

	.age-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 50%;
		background: var(--yellow);
		color: var(--green-dark);
		font-family: 'Fredoka One', cursive;
		font-size: 2.8rem;
		box-shadow: 0 4px 16px rgba(0,0,0,0.25);
		position: relative;
	}

	.hero h1 {
		font-family: 'Fredoka One', cursive;
		font-size: clamp(2rem, 6vw, 3.5rem);
		font-weight: 400;
		text-shadow: 0 2px 8px rgba(0,0,0,0.3);
		letter-spacing: 0.03em;
		position: relative;
	}

	/* ── Main content ── */
	main {
		max-width: 72ch;
		margin: 0 auto;
		padding: 2rem 1.5rem 3rem;
		font-family: 'Nunito', sans-serif;
		color: var(--text);
		background: var(--cream);
	}

	.intro {
		font-size: 1.1rem;
		line-height: 1.7;
		text-align: center;
		color: var(--brown);
		margin-bottom: 2rem;
		padding: 0 0.5rem;
	}

	/* ── Cards ── */
	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
		margin-bottom: 1.25rem;
	}

	.card {
		background: var(--card-bg);
		border: 1.5px solid var(--card-border);
		border-radius: 1rem;
		padding: 1.5rem 1.75rem;
		margin-bottom: 1.25rem;
		box-shadow: 0 2px 10px rgba(45, 106, 79, 0.07);
	}

	.card-grid .card {
		margin-bottom: 0;
	}

	.card h2 {
		font-family: 'Fredoka One', cursive;
		font-size: 1.5rem;
		font-weight: 400;
		color: var(--green-mid);
		margin: 0 0 1rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.icon {
		font-size: 1.3rem;
	}

	.card p,
	.card address {
		margin: 0 0 0.75rem;
		line-height: 1.6;
		font-style: normal;
	}

	.card ul {
		margin: 0;
		padding-left: 0;
		list-style: none;
	}

	.card ul li {
		padding: 0.4rem 0 0.4rem 1.6rem;
		position: relative;
		line-height: 1.5;
	}

	.card ul li::before {
		content: '🌿';
		position: absolute;
		left: 0;
		font-size: 0.9rem;
	}

	.rsvp-note {
		font-size: 0.88rem;
		color: var(--brown);
		font-style: italic;
		margin: 0.25rem 0 0.75rem;
		padding-left: 1.6rem;
	}

	/* ── Agenda list ── */
	.agenda {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.agenda li {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding: 0.55rem 0.75rem !important;
		border-radius: 0.5rem;
		transition: background 0.15s;
	}

	.agenda li::before {
		display: none !important;
	}

	.agenda li:hover {
		background: #f0faf4;
	}

	.time {
		font-weight: 700;
		color: var(--green-mid);
		min-width: 5.5rem;
		font-size: 0.9rem;
		letter-spacing: 0.02em;
	}

	/* ── Buttons ── */
	.btn-row {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: 1rem;
	}

	.btn {
		display: inline-block;
		padding: 0.45rem 1.1rem;
		border-radius: 2rem;
		font-family: 'Nunito', sans-serif;
		font-weight: 700;
		font-size: 0.9rem;
		text-decoration: none;
		background: var(--green-mid);
		color: white;
		transition: background 0.15s, transform 0.1s;
	}

	.btn:hover {
		background: var(--green-dark);
		transform: translateY(-1px);
	}

	.btn-outline {
		background: transparent;
		color: var(--green-mid);
		border: 2px solid var(--green-mid);
	}

	.btn-outline:hover {
		background: var(--green-mid);
		color: white;
	}

	/* ── Links ── */
	.card a:not(.btn) {
		color: var(--green-mid);
		font-weight: 700;
		text-underline-offset: 2px;
	}

	.card a:not(.btn):hover {
		color: var(--green-dark);
	}

	/* ── Calendar dropdown ── */
	.cal-dropdown {
		position: relative;
		display: inline-block;
		margin-top: 1rem;
	}

	.cal-btn {
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.chevron {
		font-style: normal;
		transition: transform 0.2s;
		display: inline-block;
	}

	.cal-dropdown.open .chevron {
		transform: rotate(180deg);
	}

	.cal-menu {
		display: none;
		position: absolute;
		top: calc(100% + 0.4rem);
		left: 0;
		background: white;
		border: 1.5px solid var(--card-border);
		border-radius: 0.6rem;
		padding: 0.35rem 0;
		margin: 0;
		list-style: none;
		min-width: 100%;
		box-shadow: 0 4px 16px rgba(45, 106, 79, 0.12);
		z-index: 10;
		white-space: nowrap;
	}

	.cal-dropdown.open .cal-menu {
		display: block;
	}

	.card .cal-menu li {
		padding-left: 0;
	}

	.cal-menu li::before {
		display: none !important;
	}

	.cal-menu a {
		display: block;
		padding: 0.5rem 1rem;
		font-family: 'Nunito', sans-serif;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text) !important;
		text-decoration: none;
	}

	.cal-menu a:hover {
		background: #f0faf4;
		color: var(--green-mid) !important;
	}

	/* ── Map ── */
	.map-card p {
		margin-bottom: 0.75rem;
	}

	.map-container {
		position: relative;
		border-radius: 0.5rem;
		overflow: hidden;
		cursor: zoom-in;
	}

	.zoo-map {
		width: 100%;
		display: block;
	}

	.map-expand-btn {
		position: absolute;
		bottom: 0.6rem;
		right: 0.6rem;
		display: flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.3rem 0.65rem;
		background: rgba(255,255,255,0.92);
		color: var(--green-dark);
		border: none;
		border-radius: 2rem;
		font-family: 'Nunito', sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		cursor: pointer;
		box-shadow: 0 2px 6px rgba(0,0,0,0.2);
		transition: background 0.15s;
	}

	.map-expand-btn:hover {
		background: white;
	}

	/* ── Map dialog / lightbox ── */
	.map-dialog {
		border: none;
		background: transparent;
		padding: 0;
		max-width: 95vw;
		max-height: 95vh;
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: 0 8px 40px rgba(0,0,0,0.5);
	}

	.map-dialog img {
		display: block;
		max-width: 95vw;
		max-height: 90vh;
		object-fit: contain;
	}

	.map-dialog::backdrop {
		background: rgba(0,0,0,0.75);
	}

	.dialog-close {
		position: absolute;
		top: 0.6rem;
		right: 0.6rem;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		border: none;
		background: rgba(255,255,255,0.92);
		color: var(--green-dark);
		font-size: 1rem;
		font-weight: 700;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 2px 6px rgba(0,0,0,0.25);
		transition: background 0.15s;
		z-index: 1;
	}

	.dialog-close:hover {
		background: white;
	}

	/* ── Footer animals ── */
	.footer-animals {
		text-align: center;
		font-size: 1.5rem;
		letter-spacing: 0.3rem;
		margin-top: 2.5rem;
		opacity: 0.5;
	}
</style>

<script>
	document.querySelectorAll('.cal-dropdown').forEach(dropdown => {
		const btn = dropdown.querySelector('.cal-btn');
		btn?.addEventListener('click', e => {
			e.stopPropagation();
			dropdown.classList.toggle('open');
		});
		document.addEventListener('click', () => dropdown.classList.remove('open'));
	});

	const dialog = document.getElementById('map-dialog') as HTMLDialogElement;
	const openBtn = document.getElementById('map-expand-btn');
	const mapContainer = document.getElementById('map-container');
	const closeBtn = document.getElementById('dialog-close');

	[openBtn, mapContainer].forEach(el => el?.addEventListener('click', () => dialog.showModal()));
	closeBtn?.addEventListener('click', () => dialog.close());
	dialog?.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
</script>
