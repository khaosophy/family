---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Eliza's Fourth Birthday">
	<div class="hero">
		<div class="row-top">🍎 🍁 🧺 🍂 🌾 🍂 🧺 🍁 🍎</div>
		<h1>
			Eliza's Fourth Birthday
			<div class="age-badge">4</div>
		</h1>
		<div class="row-bottom">🚜 🍏 🍂 🌻 🍎 🌻 🍂 🍏 🚜</div>
	</div>

	<main>
		<p class="intro">Four years old already! It feels like just yesterday she was taking her first steps, and now she's dancing, telling stories, and keeping us all on our toes. Let's celebrate another year the way she loves best — outside, with apples, friends, and family.</p>

		<div class="card-grid">
			<div class="card">
				<h2><span class="icon">🗓️</span> When?</h2>
				<p>
					<strong>Date:</strong> Saturday, October 3, 2026<br/>
					<strong>Time:</strong> 12:00pm – 4:00pm
				</p>
				<div class="cal-dropdown">
					<button class="btn btn-outline cal-btn">Add to Calendar <span class="chevron">▾</span></button>
					<ul class="cal-menu">
						<li><a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Eliza%27s+Fourth+Birthday&dates=20261003T160000Z%2F20261003T200000Z&location=Alstede+Farms%2C+1+Alstede+Farms+Ln%2C+Chester%2C+NJ+07930&details=Join+us+to+celebrate+Eliza%27s+fourth+birthday+at+Alstede+Farms!" target="_blank">Google Calendar</a></li>
						<li><a href="https://outlook.live.com/calendar/0/action/compose?subject=Eliza%27s+Fourth+Birthday&startdt=2026-10-03T16%3A00%3A00Z&enddt=2026-10-03T20%3A00%3A00Z&location=Alstede+Farms%2C+1+Alstede+Farms+Ln%2C+Chester%2C+NJ+07930&body=Join+us+to+celebrate+Eliza%27s+fourth+birthday+at+Alstede+Farms!" target="_blank">Outlook</a></li>
						<li><a href="/eliza-birthday-4.ics" download>Apple / Other (.ics)</a></li>
					</ul>
				</div>
			</div>

			<div class="card">
				<h2><span class="icon">📍</span> Where?</h2>
				<address>
					Alstede Farms<br/>
					1 Alstede Farms Ln<br/>
					Chester, NJ 07930
				</address>
				<div class="btn-row">
					<a class="btn" href="https://www.alstedefarms.com/" target="_blank">Farm Website</a>
					<a class="btn btn-outline" href="https://www.google.com/maps/place/Alstede+Farms/@40.779056,-74.713821,14z/data=!4m6!3m5!1s0x89c3990b3264ed17:0xd043541046a9664f!8m2!3d40.7789241!4d-74.7137164!16s%2Fg%2F1td7_0ft?hl=en-US&entry=ttu" target="_blank">Get Directions</a>
				</div>
			</div>
		</div>

		<div class="card">
			<h2><span class="icon">🚜</span> Parking & Tent Location</h2>
			<ul>
				<li><strong>Parking is free.</strong> Guests must park in the main parking lot behind the farm store.</li>
				<li><strong>Tent assignment:</strong> Alstede Farms only gives us our tent a few weeks ahead of time. We'll update this page (and let everyone know) as soon as we hear!</li>
			</ul>
		</div>

		<div class="card">
			<h2><span class="icon">📋</span> Agenda <span class="badge-tentative">Tentative</span></h2>
			<ul class="agenda">
				<li><span class="time">12:30pm</span> Hello & Hugs!</li>
				<li><span class="time">1:00pm</span> Apple Picking!</li>
				<li><span class="time">2:00pm</span> Lunch</li>
				<li><span class="time">2:30pm</span> Happy Birthday Desserts</li>
				<li><span class="time">3:00pm</span> Playtime!</li>
				<li><span class="time">3:30pm</span> Goodies & Good Byes</li>
			</ul>
			<p class="agenda-note">We have the private tent until 3:30, but that doesn't mean we have to leave at that point! Other activities on the farm include visiting the animals, riding the train, climbing a hay pyramid, exploring an evergreen maze, or just checking out the shop for fresh yummies.</p>
		</div>

		<div class="card">
			<h2><span class="icon">🍕</span> Food</h2>
			<p class="tbd">Still being finalized — we'll update this page once the order is placed (pizza, as always!).</p>
		</div>

		<div class="card">
			<h2><span class="icon">🎁</span> What can we gift?</h2>
			<p>No gifts, please! Her favorite thing is just being outside with friends and family (plus, I don't really have <em>space</em> for much more).</p>
			<p>If you really want to give something and are in the financial position to do so, we welcome contributions to her 529 plan. The online portal link is coming soon — check back here shortly!</p>
			<p>Otherwise, you can donate in her name to <a href="/donate">one of these vetted organizations</a>.</p>
		</div>

		<div class="card">
			<h2><span class="icon">ℹ️</span> Good to Know</h2>
			<ul>
				<li>The venue is outside, under a tent, so dress appropriately.</li>
				<li>Party is rain or shine.</li>
				<li>Wear comfortable walking shoes, especially if you plan to come fruit picking.</li>
				<li>No alcohol is allowed on site.</li>
			</ul>
		</div>

		<div class="footer-row">🍎 🍂 🧺 🍁 🍎</div>
	</main>
</Layout>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;600;700&display=swap');

	:root {
		--rust-dark: #6e2a12;
		--rust-mid: #a83e1a;
		--apple-red: #c94a26;
		--gold: #e8a33d;
		--gold-light: #fdeecb;
		--cream: #fff8ec;
		--brown: #6b4a34;
		--text: #2d2417;
		--card-bg: #ffffff;
		--card-border: #f0ddc0;
	}

	/* ── Hero ── */
	.hero {
		background: linear-gradient(160deg, var(--rust-dark) 0%, var(--rust-mid) 55%, var(--apple-red) 100%);
		color: white;
		text-align: center;
		padding: 3rem 1.5rem 2.5rem;
		position: relative;
		overflow: hidden;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image: radial-gradient(circle at 20% 80%, rgba(255,255,255,0.05) 0%, transparent 50%),
		                  radial-gradient(circle at 80% 20%, rgba(232,163,61,0.14) 0%, transparent 50%);
	}

	.row-top,
	.row-bottom {
		font-size: 1.5rem;
		letter-spacing: 0.25rem;
		opacity: 0.85;
		position: relative;
	}

	.row-bottom {
		margin-top: 1.5rem;
	}

	.age-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 50%;
		background: var(--gold);
		color: var(--rust-dark);
		font-family: 'Fredoka One', cursive;
		font-size: 2.8rem;
		box-shadow: 0 4px 16px rgba(0,0,0,0.25);
		position: relative;
	}

	.hero h1 {
		font-family: 'Fredoka One', cursive;
		font-size: clamp(2rem, 6vw, 3.5rem);
		font-weight: 400;
		text-shadow: 0 2px 8px rgba(0,0,0,0.3);
		letter-spacing: 0.03em;
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		margin: 1.25rem 0;
	}

	/* ── Main content ── */
	main {
		max-width: 72ch;
		margin: 0 auto;
		padding: 2rem 1.5rem 3rem;
		font-family: 'Nunito', sans-serif;
		color: var(--text);
		background: var(--cream);
	}

	.intro {
		font-size: 1.1rem;
		line-height: 1.7;
		text-align: center;
		color: var(--brown);
		margin-bottom: 2rem;
		padding: 0 0.5rem;
	}

	/* ── Cards ── */
	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
		margin-bottom: 1.25rem;
	}

	.card {
		background: var(--card-bg);
		border: 1.5px solid var(--card-border);
		border-radius: 1rem;
		padding: 1.5rem 1.75rem;
		margin-bottom: 1.25rem;
		box-shadow: 0 2px 10px rgba(110, 42, 18, 0.08);
	}

	.card-grid .card {
		margin-bottom: 0;
	}

	.card h2 {
		font-family: 'Fredoka One', cursive;
		font-size: 1.5rem;
		font-weight: 400;
		color: var(--rust-mid);
		margin: 0 0 1rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.icon {
		font-size: 1.3rem;
	}

	.card p,
	.card address {
		margin: 0 0 0.75rem;
		line-height: 1.6;
		font-style: normal;
	}

	.card p:last-child {
		margin-bottom: 0;
	}

	.card ul {
		margin: 0;
		padding-left: 0;
		list-style: none;
	}

	.card ul li {
		padding: 0.4rem 0 0.4rem 1.6rem;
		position: relative;
		line-height: 1.5;
	}

	.card ul li::before {
		content: '🍂';
		position: absolute;
		left: 0;
		font-size: 0.9rem;
	}

	.tbd {
		display: inline-block;
		font-style: italic;
		color: var(--brown);
		background: var(--gold-light);
		border-radius: 0.5rem;
		padding: 0.5rem 0.85rem;
	}

	.badge-tentative {
		font-family: 'Nunito', sans-serif;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: var(--brown);
		background: var(--gold-light);
		border: 1px solid var(--gold);
		border-radius: 1rem;
		padding: 0.2rem 0.6rem;
		margin-left: 0.25rem;
	}

	/* ── Agenda list ── */
	.agenda {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		margin-bottom: 1rem;
	}

	.agenda li {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding: 0.55rem 0.75rem !important;
		border-radius: 0.5rem;
		transition: background 0.15s;
	}

	.agenda li::before {
		display: none !important;
	}

	.agenda li:hover {
		background: var(--gold-light);
	}

	.time {
		font-weight: 700;
		color: var(--rust-mid);
		min-width: 5.5rem;
		font-size: 0.9rem;
		letter-spacing: 0.02em;
	}

	.agenda-note {
		margin: 0;
	}

	/* ── Buttons ── */
	.btn-row {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: 1rem;
	}

	.btn {
		display: inline-block;
		padding: 0.45rem 1.1rem;
		border-radius: 2rem;
		font-family: 'Nunito', sans-serif;
		font-weight: 700;
		font-size: 0.9rem;
		text-decoration: none;
		background: var(--rust-mid);
		color: white;
		transition: background 0.15s, transform 0.1s;
	}

	.btn:hover {
		background: var(--rust-dark);
		transform: translateY(-1px);
	}

	.btn-outline {
		background: transparent;
		color: var(--rust-mid);
		border: 2px solid var(--rust-mid);
	}

	.btn-outline:hover {
		background: var(--rust-mid);
		color: white;
	}

	/* ── Links ── */
	.card a:not(.btn) {
		color: var(--rust-mid);
		font-weight: 700;
		text-underline-offset: 2px;
	}

	.card a:not(.btn):hover {
		color: var(--rust-dark);
	}

	/* ── Calendar dropdown ── */
	.cal-dropdown {
		position: relative;
		display: inline-block;
		margin-top: 1rem;
	}

	.cal-btn {
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.chevron {
		font-style: normal;
		transition: transform 0.2s;
		display: inline-block;
	}

	.cal-dropdown.open .chevron {
		transform: rotate(180deg);
	}

	.cal-menu {
		display: none;
		position: absolute;
		top: calc(100% + 0.4rem);
		left: 0;
		background: white;
		border: 1.5px solid var(--card-border);
		border-radius: 0.6rem;
		padding: 0.35rem 0;
		margin: 0;
		list-style: none;
		min-width: 100%;
		box-shadow: 0 4px 16px rgba(110, 42, 18, 0.14);
		z-index: 10;
		white-space: nowrap;
	}

	.cal-dropdown.open .cal-menu {
		display: block;
	}

	.card .cal-menu li {
		padding-left: 0;
	}

	.cal-menu li::before {
		display: none !important;
	}

	.cal-menu a {
		display: block;
		padding: 0.5rem 1rem;
		font-family: 'Nunito', sans-serif;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text) !important;
		text-decoration: none;
	}

	.cal-menu a:hover {
		background: var(--gold-light);
		color: var(--rust-mid) !important;
	}

	/* ── Footer row ── */
	.footer-row {
		text-align: center;
		font-size: 1.5rem;
		letter-spacing: 0.3rem;
		margin-top: 2.5rem;
		opacity: 0.5;
	}
</style>

<script>
	document.querySelectorAll('.cal-dropdown').forEach(dropdown => {
		const btn = dropdown.querySelector('.cal-btn');
		btn?.addEventListener('click', e => {
			e.stopPropagation();
			dropdown.classList.toggle('open');
		});
		document.addEventListener('click', () => dropdown.classList.remove('open'));
	});
</script>
